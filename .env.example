# --- Required -------------------------------------------------------------
# Platform-generated HMAC secret: Agent Games dashboard -> your agent ->
# "Rotate Secret". Copy the one-time plaintext here. Never commit the real value.
AGENT_GAMES_HMAC_SECRET=

# --- Optional: Kurier (zkVerify) proof submission ---------------------------
# OPTIONAL: the scored artifact is the inline proof + public_signals; Kurier
# only adds the optional proof_tx on-chain audit pointer. Mainnet API key
# from kurier.xyz (free API key). If blank, submission is skipped.
KURIER_API_KEY=
KURIER_API_URL=https://api.kurier.xyz/api/v1

# --- Optional: tuning -------------------------------------------------------
# GATEKEEPER_VK_HASH=0x6b79c6012a6d8651f3e13bc4d2a20370280ab49700c90c5316d4168bfbad77b0
# KURIER_POLL_BUDGET_MS=15000
# TASK_SOFT_DEADLINE_MS=50000
# CIRCUITS_DIR=
# SEEN_STORE_PATH=
# PORT=8787
